{
  "name": "org-chart-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "build-development": "NODE_TLS_REJECT_UNAUTHORIZED=0 vite build --sourcemap=true --mode development",
    "build-staging": "vite build --mode staging",
    "build-production": "vite build --mode production",
    "publish-local": "npm run build-production && LOCAL=true node node_modules/@hailer/app-sdk/lib/tools/publish.cjs ./`npm pack` --local",
    "publish-development": "npm run build-development && node node_modules/@hailer/app-sdk/lib/tools/publish.cjs ./`npm pack` --development",
    "publish-staging": "npm run build-staging && node node_modules/@hailer/app-sdk/lib/tools/publish.cjs ./`npm pack` --staging",
    "publish-production": "npm run build-production && node node_modules/@hailer/app-sdk/lib/tools/publish.cjs ./`npm pack` --production"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@hailer/app-sdk": "1.0.3",
    "framer-motion": "^11.0.3",
    "react": "^18.2.0",
    "react-d3-tree": "^3.6.6",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.24",
    "@types/react-dom": "^18.2.8",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "@vitejs/plugin-react": "^4.1.0",
    "eslint": "^8.50.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "typescript": "^5.2.2",
    "vite": "^4.4.11"
  }
}
